# ─────────────────────────────────────────────────────────────
#  INERA GROUP — Environment variables
#  Copy this file to `.env` locally, and add the same two keys
#  in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Supabase project URL  (Supabase → Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase anon/public key (Supabase → Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=

# Admin password for /admin  (optional — defaults to the value in
# src/config/site.js if you leave this blank)
VITE_ADMIN_PASSWORD=
